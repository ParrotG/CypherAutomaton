# Copy this file to .env.local and keep it private:
#   cp .env.local.example .env.local
#   chmod 600 .env.local
#
# In the arena, organizers always inject CTF_*. Day 1 injects no LLM_*;
# Day 2 injects LLM_* and those override the image values.
# These local provider settings are for local tests only.

# Platform (local live-test only)
CTF_BASE=https://hackathon.in-cypher.com
CTF_TOKEN=ctfd_your_token_here

# Target set: auto | practice | competition. auto is the production default.
# ARENA_MODE=auto

# Choose deepseek or openrouter. Both target DeepSeek V4.1 Flash:
# - direct DeepSeek API model id: deepseek-flash
# - OpenRouter model id: deepseek/deepseek-v4.1-flash
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Context / token / step budget
# MAX_STEPS is an unreachable final backstop; token budget controls in practice.
MAX_STEPS=1000000
MAX_ATTEMPTS=3
CONTEXT_WINDOW_TOKENS=1000000
CONTEXT_RESERVE_TOKENS=8000
MAX_ATTEMPT_TOKENS=1000000
MAX_PLAIN_REPLIES=3

# Dynamic instance renewable interval in seconds
RENEW_INTERVAL_SECONDS=60

# Set to 0 to intercept flag submissions and treat them as successful.
# Useful for full-pipeline testing after a practice reset.
SUBMIT_FLAGS=1

# Scheduler concurrency. Dynamic challenges are serialized by a global lock.
MAX_CONCURRENT_CHALLENGES=2
PRELOAD_WORKERS=2

# Per-challenge parallel agents. 2 challenge slots * 2 agents = up to 4 agents.
AGENTS_PER_CHALLENGE=2
DYNAMIC_AGENTS_PER_CHALLENGE=2

# Hard per-challenge wall-clock deadline (seconds). On timeout the challenge is
# destroyed/stopped and moved to the tail of the scheduler queue.
CHALLENGE_TIME_LIMIT_SECONDS=3600
