# Copy this file to .env.local and fill in your own secrets.
# Keep the resulting file private:
#   cp .env.local.example .env.local
#   chmod 600 .env.local

# Required for raw-TCP challenges / the bridge:
CYPHER_TEAM_KEY=

# Required for the minimal agent unit:
DEEPSEEK_API_KEY=
# Optional model settings (defaults shown):
# CYPHER_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# CYPHER_THINKING=disabled

# Optional aliases also accepted:
# INCYPHER_TEAM_KEY=
# TEAM_KEY=
