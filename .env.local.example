# Copy this file to .env.local and keep it private:
#   cp .env.local.example .env.local
#   chmod 600 .env.local
#
# Values below are examples for LOCAL testing. In the arena, the organizers
# inject CTF_* and LLM_* at runtime; never bake CTF_TOKEN into an image.

# Official platform (local live-test only)
CTF_BASE=https://hackathon.in-cypher.com
CTF_TOKEN=ctfd_your_token_here

# OpenAI-compatible model endpoint used by the arena Brain.
# Day 1 local testing needs your own key. Day 2 organizers inject LLM_*.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=your_llm_key_here
