# Copy this file to .env.local and keep it private:
#   cp .env.local.example .env.local
#   chmod 600 .env.local
#
# In the arena, the organizers inject CTF_* and LLM_* at runtime.
# These local provider settings are for local tests only.

# Platform (local live-test only)
CTF_BASE=https://hackathon.in-cypher.com
CTF_TOKEN=ctfd_your_token_here

# Choose deepseek or openrouter. Both target DeepSeek V4.1 Flash:
# - direct DeepSeek API model id: deepseek-flash
# - OpenRouter model id: deepseek/deepseek-v4.1-flash
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Context / step budget
MAX_STEPS=1000000
MAX_ATTEMPTS=3
CONTEXT_WINDOW_TOKENS=1000000
CONTEXT_RESERVE_TOKENS=8000

# Set to 0 to intercept flag submissions and treat them as successful.
# Useful for full-pipeline testing after a practice reset.
SUBMIT_FLAGS=1

# Scheduler concurrency. Dynamic challenges are serialized by a global lock.
MAX_CONCURRENT_CHALLENGES=2
PRELOAD_WORKERS=2
